<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p>Description: <%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString() %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <% if (user) { %>
        <h3>Volunteer</h3>
        <% if (volunteered) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST">
                <input type="hidden" name="volunteerCsrfToken" value="<%= volunteerCsrfToken %>">
                <button type="submit">Cancel signup</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <input type="hidden" name="volunteerCsrfToken" value="<%= volunteerCsrfToken %>">
                <button type="submit">Volunteer</button>
            </form>
        <% } %>
    <% } %>

    <h3>Categories</h3>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
    <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
    <% if (user && user.role_name === 'admin') { %>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
